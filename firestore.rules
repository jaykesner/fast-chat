rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidRoomId(roomId) {
      return roomId.matches('^[A-Z0-9]{5}$');
    }

    function isValidRoomCreate() {
      return request.resource.data.keys().hasOnly(['createdAt', 'createdBy'])
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() > 0
        && request.resource.data.createdBy.size() <= 40
        && request.resource.data.createdAt == request.time;
    }

    function isValidMessageCreate() {
      return request.resource.data.keys().hasOnly(['text', 'author', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 40
        && request.resource.data.createdAt == request.time;
    }

    match /rooms/{roomId} {
      allow read: if isValidRoomId(roomId);
      allow create: if isValidRoomId(roomId) && isValidRoomCreate();
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isValidRoomId(roomId);
        allow create: if isValidRoomId(roomId) && isValidMessageCreate();
        allow update, delete: if false;
      }
    }
  }
}
